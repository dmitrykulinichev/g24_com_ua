APP_NAME=Garage24
APP_URL=http://g24.loc
APP_ENV=local
APP_DEBUG=true

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Основна CRM
MAIN_CRM_URL=https://app.g24.com.ua/api/leads
MAIN_CRM_KEY=YOUR_API_KEY

# Google reCAPTCHA v2 (Fallback, якщо API не поверне ключ)
RECAPTCHA_SITE_KEY=YOUR_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_SECRET_KEY

SPA_API_URL=http://localhost:8000

# Час життя кешу цін (в секундах). 86400 = 24 години
PRICING_CACHE_TTL=86400

# Ключ для доступу до SPA API
LANDING_API_KEY=your_secret_landing_key_here