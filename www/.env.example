APP_NAME=Garage24
APP_URL=https://g24.com.ua
APP_ENV=local
APP_DEBUG=true

# Telegram Bot (Резервне сповіщення)
TELEGRAM_BOT_TOKEN=####
TELEGRAM_CHAT_ID=-1003602393389

# Інтеграція з SPA (SaaS Platform)
SPA_API_URL=http://localhost:8000
LANDING_API_KEY=####

# Google reCAPTCHA v3 (Invisible)
RECAPTCHA_SITE_KEY=####
RECAPTCHA_SECRET_KEY=####
RECAPTCHA_ENABLED=true

# Кешування
API_CONFIG_CACHE_TTL=0

LOG_MAX_FILES=16

# Sitemap generation key (захищає ендпоінт /api/sitemap/generate?key=...)
SITEMAP_KEY=

# Ключ синхронізації блогу — частина шляху /api/blog/sync/{token}, довгий
# випадковий рядок (напр. bin2hex(random_bytes(32))), а не query-параметр
BLOG_SYNC_KEY=

# Google Analytics
GOOGLE_ANALYTICS_ID=